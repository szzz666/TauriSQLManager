{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri SQL Manager",
  "version": "1.0.7",
  "identifier": "top.szzz666.taurisqlmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tauri SQL Manager",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "跨平台数据库管理桌面应用",
    "longDescription": "基于 Tauri 2 + Vue 3 + Element Plus 构建的数据库管理桌面应用，支持 SQLite、MySQL、MariaDB、PostgreSQL 与 SQL Server。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}
